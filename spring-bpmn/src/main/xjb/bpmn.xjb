<?xml version="1.0" encoding="UTF-8"?>
<!--
  XJC bindings for the BPMN 2.0 schemas.
  - Semantic.xsd is included by BPMN20.xsd, so both share the namespace .../BPMN/20100524/MODEL
    and XJC allows only one package per namespace: BPMN20 + Semantic go to package bpmn20.
  - BPMNDI, DC and DI each have their own namespace and package.
  - The "t" prefix of the type names in Semantic.xsd/BPMN20.xsd is dropped (tProcess -> Process).
    Types whose name would clash with a java.lang class get the suffix "Type" (tError -> ErrorType).
  - Generated by a script from the xsd:complexType/xsd:simpleType names; edit by hand if types change.
-->
<jaxb:bindings version="3.0"
               xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <jaxb:bindings schemaLocation="../resources/xsd/bpmn/BPMN20.xsd" node="/xsd:schema">
        <jaxb:schemaBindings><jaxb:package name="de.nemeses.spring.bpmn.model.bpmn20"/></jaxb:schemaBindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../resources/xsd/bpmn/BPMNDI.xsd" node="/xsd:schema">
        <jaxb:schemaBindings><jaxb:package name="de.nemeses.spring.bpmn.model.bpmndi"/></jaxb:schemaBindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../resources/xsd/bpmn/DC.xsd" node="/xsd:schema">
        <jaxb:schemaBindings><jaxb:package name="de.nemeses.spring.bpmn.model.dc"/></jaxb:schemaBindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../resources/xsd/bpmn/DI.xsd" node="/xsd:schema">
        <jaxb:schemaBindings><jaxb:package name="de.nemeses.spring.bpmn.model.di"/></jaxb:schemaBindings>
    </jaxb:bindings>
