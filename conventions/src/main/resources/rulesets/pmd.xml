    <!-- custom rule to enforce 'rollbackFor' on @Transactional -->
    <rule name="DeclareRollbackForInTransactional"
          language="java"
          message="Explicitely declare 'rollbackFor' if your @Transactional method throws checked Exceptions."
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
       <description>
          The default behaviour of @Transactional for if rollback
          on RuntimeException and Error, but do not roll back on declared
          exception. This is not what most Developers expect. Thus
          this rule enforces to explicitely set the `rollbackFor` attribute
          if there are Exceptions declared on the method.
       </description>
       <priority>3</priority>
       <properties>
          <property name="xpath">
             <value>
    <![CDATA[
        //ClassOrInterfaceBodyDeclaration[@Kind = 'METHOD'
            and count(./MethodDeclaration/NameList/Name)>0
            and .//Annotation[@AnnotationName = 'Transactional'
                and count(.//MemberValuePair[@MemberName = 'rollbackFor'])=0]
        ]
    ]]>
             </value>
          </property>
       </properties>
    </rule>


