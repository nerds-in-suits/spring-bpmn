<?xml version="1.0" encoding="UTF-8"?>
<!--
Logging of the demo application: Spring Boot's console appender plus a plain, non-rolling file appender.
Spring Boot's own file appender rolls the file and writes *.gz archives; the demo log file is never rotated.
File name, thresholds, patterns and levels still come from the logging.* properties in application.yaml.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${FILE_LOG_THRESHOLD}</level>
        </filter>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_FILE:-demo.log}</file>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
