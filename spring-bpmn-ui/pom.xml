<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>spring-bpmn-ui</artifactId>
    <name>Spring BPMN UI</name>

    <parent>
        <groupId>de.nemeses.spring</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <properties>
        <alpinejs.version>3.17.5</alpinejs.version>
        <bpmn-js.version>18.31.1</bpmn-js.version>
        <bpmn-moddle.version>10.3.1</bpmn-moddle.version>
        <min-dash.version>5.1.0</min-dash.version>
        <moddle.version>8.2.1</moddle.version>
        <moddle-xml.version>12.3.2</moddle-xml.version>
        <saxen.version>11.2.0</saxen.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.nemeses.spring</groupId>
            <artifactId>spring-bpmn-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>alpinejs</artifactId>
            <version>${alpinejs.version}</version>
        </dependency>
        <dependency>
            <!-- only the prebuilt viewer bundle in dist/ is used, which contains its npm dependencies -->
            <groupId>org.webjars.npm</groupId>
            <artifactId>bpmn-js</artifactId>
            <version>${bpmn-js.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- ES modules of the vendored bpmn-auto-layout and its npm dependencies, pinned to the versions it was checked with -->
            <groupId>org.webjars.npm</groupId>
            <artifactId>bpmn-moddle</artifactId>
            <version>${bpmn-moddle.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>min-dash</artifactId>
            <version>${min-dash.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>moddle</artifactId>
            <version>${moddle.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>moddle-xml</artifactId>
            <version>${moddle-xml.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>saxen</artifactId>
            <version>${saxen.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The application secures the UI; the tests use Spring Boot's default security. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The tests run the real engine on the JPA repositories and the JPA task persistence on H2. -->
        <dependency>
            <groupId>de.nemeses.spring</groupId>
            <artifactId>spring-bpmn-repository-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.nemeses.spring</groupId>
            <artifactId>spring-tasks-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
